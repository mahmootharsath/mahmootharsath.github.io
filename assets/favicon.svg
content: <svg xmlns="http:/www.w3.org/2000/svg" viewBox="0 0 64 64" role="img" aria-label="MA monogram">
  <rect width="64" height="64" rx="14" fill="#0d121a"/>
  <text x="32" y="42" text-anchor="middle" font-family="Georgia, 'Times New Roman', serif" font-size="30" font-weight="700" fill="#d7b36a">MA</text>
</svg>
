    ul { margin: 0; padding-left: 18px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .label { font-weight: 700; }
    @media (max-width: 700px) {
      body { padding: 16px; }
      .header, .content { padding-left: 20px; padding-right: 20px; }
